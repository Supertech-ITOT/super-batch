{
  "name": "superbatch-desktop",
  "version": "1.0.0",
  "description": "SuperBatch Desktop Application",
  "author": "SuperTech",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "dev": "npm run build && npm run start",
    "watch": "tsc --watch",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.superbatch.desktop",
    "productName": "SuperBatch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico"
    }
  }
}
